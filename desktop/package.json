{
  "name": "pockpock-desktop",
  "productName": "PockPock Agent",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop agent app for PockPock AI",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:127.0.0.1:5180 && cross-env POCKPOCK_DESKTOP_DEV=1 node scripts/launch.cjs\"",
    "build": "tsc -b && vite build",
    "app": "node scripts/launch.cjs",
    "start": "npm run build && node scripts/launch.cjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
