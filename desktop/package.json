{
  "name": "pockpock-desktop",
  "productName": "PockPock Agent",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop agent app for PockPock AI",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:127.0.0.1:5180 && cross-env POCKPOCK_DESKTOP_DEV=1 node scripts/launch.cjs\"",
    "build": "tsc -b && vite build",
    "app": "node scripts/launch.cjs",
    "start": "npm run build && node scripts/launch.cjs",
    "typecheck": "tsc -b --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "author": "PockPock",
  "build": {
    "appId": "ai.pockpock.agent",
    "productName": "PockPock Agent",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/icon.*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/test_*.py",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PockPock Agent",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PockPock-Agent-Setup-${version}.exe",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "artifactName": "PockPock-Agent-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "PockPock Agent ${version}",
      "artifactName": "PockPock-Agent-${version}-mac-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
