{
  "manifest_version": 3,
  "name": "PockPock Chrome Companion",
  "version": "0.1.0",
  "description": "Explicitly pair one Chrome tab with PockPock AI.",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "PockPock Chrome Companion",
    "default_popup": "popup.html"
  }
}
